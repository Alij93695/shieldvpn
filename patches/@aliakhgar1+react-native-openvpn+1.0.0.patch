@@ -0,0 +1,16 @@
+package com.openvpn;
+
+/**
+ * ShieldVPN: set by DisconnectVPN when the user stops the VPN from the
+ * notification, so OpenvpnModule can mark the next DISCONNECTED event as
+ * user-initiated. Without it JS cannot tell a user stop from a server dropping
+ * and would dial the next server.
+ *
+ * A plain holder rather than a field on OpenvpnModule, because that class is
+ * annotated @RequiresApi(O) while the app supports API 24.
+ */
+public final class StopSignal {
+    public static volatile boolean userRequestedStop = false;
+
+    private StopSignal() {}
+}
